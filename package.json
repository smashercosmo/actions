{
  "name": "actions",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "lint:ox": "oxlint --type-aware",
    "lint:types": "tsc",
    "lint": "pnpm lint:ox && pnpm lint:types",
    "test": "vitest run --project unit",
    "test:act": "vitest run --project act",
    "update:deps": "pnpm up -r --latest --interactive"
  },
  "devDependencies": {
    "@octokit/types": "18.0.0",
    "@octokit/webhooks-types": "7.6.1",
    "@pnpm/releasing.versioning": "1100.3.9",
    "@smashercosmo/configs": "0.2.0",
    "@types/node": "26.6.6",
    "act-test-runner": "2.0.0",
    "eslint-plugin-regexp": "3.3.3",
    "msw": "3.0.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "verdaccio": "7.1.1",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "imports": {
    "#gh/*": "./.github/*",
    "#shared/*": "./shared/*"
  }
}
