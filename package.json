{
  "name": "actions",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "lint:ox": "oxlint --type-aware",
    "lint:types": "tsc",
    "lint": "pnpm lint:ox && pnpm lint:types",
    "test:act": "pnpm build && vitest run"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "@octokit/auth-app": "8.3.1",
    "@octokit/webhooks-types": "7.6.1",
    "@pnpm/releasing.versioning": "1100.3.9",
    "@smashercosmo/configs": "0.1.0",
    "@types/node": "24.19.2",
    "act-test-runner": "2.0.0",
    "eslint-plugin-regexp": "3.3.3",
    "graphql": "17.1.0",
    "msw": "3.0.5",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "verdaccio": "7.1.0",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
