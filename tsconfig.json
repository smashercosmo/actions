{
  "extends": "@smashercosmo/configs/ts/node",
  /** `**` skips dot-directories, so include the workflow tests explicitly. */
  "include": ["**/*.ts", ".github/tests/**/*.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/tsconfig.tsbuildinfo",
    /**
     * Actions run TypeScript directly on Node.js, which strips types but does
     * not map `.js` specifiers back to `.ts` files.
     */
    "allowImportingTsExtensions": true
  }
}
